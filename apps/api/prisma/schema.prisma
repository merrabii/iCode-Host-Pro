// Prisma schema — Phase 1 auth domain (ADR-016).
// Supersedes the zero-table Phase 0 (ADR-014) for the authentication domain only:
// introduces the first real, justified business tables `User` and `RefreshToken`,
// and the real migration baseline (`_prisma_migrations`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase 10 (ADR-027): support ladder — USER < SUPPORT_L1 < SUPPORT_L2 <
// SUPPORT_L3 < ADMIN. Rank semantics are enforced in auth/roles.ts
// (ROLE_RANK) and shared by RolesGuard, tickets, console support, web.
enum Role {
  ADMIN
  USER
  SUPPORT_L1
  SUPPORT_L2
  SUPPORT_L3
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[] // audit entries this user performed (Phase 4)
  subscriptions Subscription[] // client-owned subscriptions (Phase 5)
  issuedInvites Invitation[] // invitations this admin issued (Phase 5)

  // ── Phase 10 (ADR-027): MFA + OAuth linking ───────────────────────────────
  // mfaSecretEnc: TOTP secret, AES-256-GCM at rest (CryptoService) — NEVER
  // returned by the API (only mfaEnabled is). oauthProvider/oauthSubject:
  // linked Google/GitHub identity (one provider + its subject); the pair is
  // unique so one social identity can never be attached to two accounts.
  // githubTokenEnc: GitHub OAuth access token, AES-256-GCM at rest, used by
  // Phase 10bis (repo auto-detection + Coolify deploy) — also never returned.
  mfaSecretEnc   String?
  mfaEnabled     Boolean @default(false)
  oauthProvider  String?
  oauthSubject   String?
  githubTokenEnc String?

  supportCodes      SupportCode[]
  tickets           Ticket[]
  ticketMessages    TicketMessage[]
  knowledgeArticles KnowledgeArticle[] // articles de base de connaissance (Phase 11)

  @@unique([oauthProvider, oauthSubject])
  @@index([email])
}

// Phase 10 (ADR-027): SINGLETON security feature-flags (one row, same pattern
// as MailSetting). EVERY security option stays NON-mandatory: the admin turns
// each on/off to strengthen or relax security. Defaults are all OFF.
model SecuritySetting {
  id                      String   @id @default(cuid())
  turnstileEnabled        Boolean  @default(false)
  // Phase 11 (demande propriétaire) : l'admin saisit/modifie les clés Turnstile
  // dans l'UI (/manager/securite) — la clé site est PUBLIQUE (côté widget), la
  // clé secret est chiffrée AES-256-GCM au repos (jamais exposée, hasSecretKey).
  turnstileSiteKey        String? // site key publique (widget client)
  turnstileSecretEnc      String? // secret key chiffrée (siteverify serveur)
  oauthGoogleEnabled      Boolean  @default(false)
  oauthGithubEnabled      Boolean  @default(false)
  mfaRequiredForAdmins    Boolean  @default(false)
  selfRegistrationEnabled Boolean  @default(false) // création de compte à la commande
  deployEnabled           Boolean  @default(false) // Phase 10bis GitHub → Coolify
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// Phase 10 (ADR-027): client-generated 6-digit support access code. The raw
// code is shown ONCE and never stored: only HMAC-SHA256(pepper, code) is kept
// (`codeHash`). One active code per client (generation revokes the previous in
// a $transaction). 5 wrong attempts auto-lock (revokedAt).
model SupportCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Phase 10 (ADR-027): minimal support tickets. `escalatedTo` reuses the Role
// enum (only SUPPORT_L2 / SUPPORT_L3 are valid escalation targets, enforced in
// the service). `authorEmail` on messages is a denormalized snapshot that
// survives the author being deleted.
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Ticket {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(NORMAL)
  escalatedTo Role?
  escalatedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages TicketMessage[]

  @@index([userId])
  @@index([status])
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorEmail String // dénormalisé (survit à la suppression de l'auteur)
  body        String
  createdAt   DateTime @default(now())

  @@index([ticketId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // sha256 of the raw refresh token; raw value never stored
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ── Phase 2 — core domain (ADR-017): platform-global reference entities ──────
// Product (catalog item) and Server (infrastructure host) are GLOBAL platform
// data, administered by the platform in /manager. They carry NO ownerId: they are
// NOT client-owned. Client-owned resources (Subscription/Service/Deployment…) are
// deliberately deferred to future phases when a real workflow needs them.
// Access: Product readable by any authenticated; soldered mutations ADMIN-only.
// Server fully ADMIN-only (internal infrastructure must not be exposed to clients).

enum ProductStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ServerStatus {
  UNKNOWN
  PROVISIONING
  ACTIVE
  PROBLEM
  REMOVED
}

// Module de panneau serveur (adaptateur d'infra). Début = les deux fournisseurs
// ciblés ; cPanel / DirectAdmin / autres s'ajouteront quand leurs connecteurs
// seront configurés (ADR-010 providers, ADR-024).
enum ServerPanelProvider {
  NONE
  HESTIA
  COOLIFY
}

model Product {
  id        String        @id @default(cuid())
  name      String        @unique
  kind      String        @default("generic") // not an enum yet: product-kind list is immature; promote when stable
  status    ProductStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  subscriptions Subscription[] // clients subscribing to this offering (Phase 5)
}

model Server {
  id       String       @id @default(cuid())
  name     String       @unique
  hostname String
  status   ServerStatus @default(UNKNOWN)

  // Détails d'infrastructure (ADR-024) — affichés/édités sur /manager/serveurs,
  // alimentés plus tard par la vraie connexion aux serveurs (ADR-007/010).
  ipAddress        String? // adresse IP publique/privée
  port             Int? // port de gestion (SSH/API)
  provider         String? // fournisseur (Hetzner, OVH, VPS…)
  region           String? // région / localisation (ex. fra1, paris)
  quotaMaxAccounts Int? // quota max de comptes hébergés
  strictTls        Boolean             @default(true) // vérifier strictement les certificats TLS des requêtes API
  panelProvider    ServerPanelProvider @default(NONE) // adaptateur de panneau serveur

  // Sonde de connectivité réelle (Phase 8, ADR-025) — alimentés par
  // POST /api/servers/:id/check. null = jamais sondé ; le statut reste piloté
  // manuellement par l'admin (le résultat de la sonde propose une bascule).
  lastCheckedAt   DateTime?
  lastProbeOk     Boolean?
  lastProbeDetail String?

  // Crédentials API panneau + état de vérification (Phase 9, ADR-010/ADR-008).
  // alimentés/décryptés uniquement côté API ; `apiTokenEnc` est toujours chiffré
  // au repos (AES-256-GCM via CryptoService, clé maîtresse ENCRYPTION_KEY) et
  // JAMAIS renvoyé par l'API (seul `hasApiToken` l'est, dans la vue masquée).
  apiBaseUrl      String? // URL de base de l'API du panneau (ex. https://panel.exemple.com/api/v1)
  apiTokenEnc     String? // jeton/clé d'accès API chiffré au repos (jamais déchiffré côté client)
  apiUser         String? // utilisateur API (Hestia : « api » ; Coolify : inutilisé)
  panelVerifiedAt DateTime? // dernier POST /api/servers/:id/panel-verify
  panelOk         Boolean? // résultat du dernier test API (true = panneau joignable + authentifié)
  panelDetail     String? // détail lisible du dernier test API

  // Métriques annoncées du serveur (Phase 9bis) — auto-détectées via l'API du
  // panneau quand c'est possible (Hestia `sysinfo`), sinon saisies manuellement
  // par l'admin (détails impossibles à récupérer => champ libre). null = inconnu.
  ramMb          Int? // RAM totale (Mo)
  cpuCores       Int? // nombre de cœurs CPU
  diskGb         Int? // disque total (Go)
  bandwidthLimit String? // limite de bande passante (label libre, ex. "2 To / mois")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[] // services this host is assigned to (Phase 5)
}

// ── Phase 4 — audit journal (ADR-019) ────────────────────────────────────────
// Append-only, readable only by ADMIN, emitted explicitly by services. No
// update/delete endpoints. actorId is a real (nullable) FK to User — null when
// the actor isn't a valid account (e.g. a failed login). actorEmail is a
// denormalized snapshot that survives the user being deleted or renamed.
// resourceType/resourceId are polymorphic strings (the referenced resource
// varies: user/product/server), so there is deliberately NO relation to them.

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail   String?
  action       String
  resourceType String?
  resourceId   String?
  details      Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([resourceType])
  @@index([action])
}

// ── Phase 5 — invitations (ADR-020) ─────────────────────────────────────────
// Public self-registration is CLOSED (ADR-020). New USER accounts are created
// only through an ADMIN-issued invitation. The raw invite token is shown once
// (surfaced in /manager until an email strategy exists); only its sha256 is
// stored, like the refresh token. issuerId is nullable + SetNull so a deleted
// admin's pending invites survive.

model Invitation {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique // sha256 of the raw one-time token
  issuerId  String?
  issuer    User?     @relation(fields: [issuerId], references: [id], onDelete: SetNull)
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// ── Phase 5 — client workspace (ADR-021) ────────────────────────────────────
// First CLIENT-OWNED resources (the workflow ADR-017 deferred until a real one
// existed): a USER subscribes to a platform Product; once an ADMIN approves the
// Subscription, the client can request a Service under it; the ADMIN assigns a
// hosting Server (the client never touches infrastructure). Provisioning is a
// status-transition STUB — real provider deploy (ADR-010) and async jobs
// (ADR-007) remain OUT of scope and Deployment stays deferred.
// Ownership is enforced in the service layer: a USER can only reach their own
// subscriptions/services (404 for anyone else's).

enum SubscriptionStatus {
  PENDING
  ACTIVE // approved by admin
  REJECTED
  SUSPENDED
  CANCELLED
}

enum ServiceStatus {
  REQUESTED
  PROVISIONING // stub transition, set by admin
  ACTIVE
  PROBLEM
  SUSPENDED
  REMOVED
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  status    SubscriptionStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  services Service[]

  @@index([userId])
  @@index([status])
}

model Service {
  id             String        @id @default(cuid())
  name           String
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  serverId       String?
  server         Server?       @relation(fields: [serverId], references: [id], onDelete: SetNull)
  status         ServiceStatus @default(REQUESTED)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([subscriptionId])
}

// ── Phase 6 — mail/SMTP configuration (ADR-022) ─────────────────────────────
// SINGLETON row (one row, managed firstOrCreate by MailSettingsService): the
// admin-managed SMTP configuration used to EMAIL invitation links (the Phase 5
// manual token surfacing in /manager stays as a fallback). `enabled` gates
// AUTOMATIC sending on invite creation; the manual "send test email" endpoint
// works against the saved config regardless. `passwordEnc` holds the SMTP
// password AES-256-GCM-encrypted at rest (CryptoService, master key
// ENCRYPTION_KEY) — it is NEVER returned by the API (only `hasPassword`).

model MailSetting {
  id          String   @id @default(cuid())
  enabled     Boolean  @default(false)
  host        String
  port        Int      @default(587)
  secure      Boolean  @default(false) // true = implicit TLS (465), false = STARTTLS (587)
  user        String?
  passwordEnc String?
  fromEmail   String
  fromName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Phase 11 — base de connaissance (KnowledgeArticle) ──────────────────────
// UNE table pour les DEUX bases demandées par le propriétaire :
//  - `audience = ADMIN` : base "Admin only" — articles INFORMATIF (récap des
//    phases effectuées, champ `phase` lié), TECHNIQUE (détails d'implémentation)
//    et HOWTO (comment utiliser les options du système) — jamais servis au client.
//  - `audience = CLIENT` : base accessible au client (/aide) — articles de
//    support / explication des options, le tout géré et publié par l'admin
//    (statut DRAFT → PUBLISHED → ARCHIVED ; seul PUBLISHED est servi).
// `body` est du HTML (sanitisé à l'affichage), `summary` un extrait en clair.
// `slug` est unique par audience. L'API n'expose jamais un article non-PUBLISHED
// côté client ; côté admin, tout est visible.

enum KnowledgeAudience {
  ADMIN // base interne admin : informative / technique / howto
  CLIENT // base publique /aide : support + explication des options
}

enum KnowledgeType {
  INFORMATIVE // récap des phases effectuées (ADMIN)
  TECHNICAL // détails techniques du projet (ADMIN)
  HOWTO // guide "comment faire" (ADMIN) — et support (CLIENT)
}

enum KnowledgeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model KnowledgeArticle {
  id          String            @id @default(cuid())
  audience    KnowledgeAudience
  type        KnowledgeType
  status      KnowledgeStatus   @default(DRAFT)
  title       String
  slug        String
  summary     String?
  body        String // HTML
  category    String? // catégorie client (ex. "Prise en main", "Facturation") — ADMIN: phase ou domaine
  phase       String? // ex. "Phase 10" — lié à un article INFORMATIF
  tags        String[]          @default([]) // étiquettes libres (recherche)
  authorId    String?
  author      User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorEmail String // dénormalisé (survit à la suppression de l'auteur)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  publishedAt DateTime?

  @@unique([audience, slug])
  @@index([audience, status])
  @@index([audience, category])
}
