// Prisma schema — Phase 1 auth domain (ADR-016).
// Supersedes the zero-table Phase 0 (ADR-014) for the authentication domain only:
// introduces the first real, justified business tables `User` and `RefreshToken`,
// and the real migration baseline (`_prisma_migrations`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase 10 (ADR-027): support ladder — USER < SUPPORT_L1 < SUPPORT_L2 <
// SUPPORT_L3 < ADMIN. Rank semantics are enforced in auth/roles.ts
// (ROLE_RANK) and shared by RolesGuard, tickets, console support, web.
enum Role {
  ADMIN
  USER
  SUPPORT_L1
  SUPPORT_L2
  SUPPORT_L3
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[] // audit entries this user performed (Phase 4)
  subscriptions Subscription[] // client-owned subscriptions (Phase 5)
  issuedInvites Invitation[] // invitations this admin issued (Phase 5)

  // ── Phase 10 (ADR-027): MFA + OAuth linking ───────────────────────────────
  // mfaSecretEnc: TOTP secret, AES-256-GCM at rest (CryptoService) — NEVER
  // returned by the API (only mfaEnabled is). oauthProvider/oauthSubject:
  // linked Google/GitHub identity (one provider + its subject); the pair is
  // unique so one social identity can never be attached to two accounts.
  // githubTokenEnc: GitHub OAuth access token, AES-256-GCM at rest, used by
  // Phase 10bis (repo auto-detection + Coolify deploy) — also never returned.
  mfaSecretEnc   String?
  mfaEnabled     Boolean @default(false)
  oauthProvider  String?
  oauthSubject   String?
  githubTokenEnc String?

  supportCodes      SupportCode[]
  tickets           Ticket[]
  ticketMessages    TicketMessage[]
  knowledgeArticles KnowledgeArticle[] // articles de base de connaissance (Phase 11)
  deployments       Deployment[] // déploiements GitHub → Coolify (Phase 10bis)
  clientProjects    ClientProject[] // projets Coolify dédiés du client (Module B)

  @@unique([oauthProvider, oauthSubject])
  @@index([email])
}

// Phase 10 (ADR-027): SINGLETON security feature-flags (one row, same pattern
// as MailSetting). EVERY security option stays NON-mandatory: the admin turns
// each on/off to strengthen or relax security. Defaults are all OFF.
model SecuritySetting {
  id                      String   @id @default(cuid())
  turnstileEnabled        Boolean  @default(false)
  // Phase 11 (demande propriétaire) : l'admin saisit/modifie les clés Turnstile
  // dans l'UI (/manager/securite) — la clé site est PUBLIQUE (côté widget), la
  // clé secret est chiffrée AES-256-GCM au repos (jamais exposée, hasSecretKey).
  turnstileSiteKey        String? // site key publique (widget client)
  turnstileSecretEnc      String? // secret key chiffrée (siteverify serveur)
  oauthGoogleEnabled      Boolean  @default(false)
  oauthGithubEnabled      Boolean  @default(false)
  mfaRequiredForAdmins    Boolean  @default(false)
  selfRegistrationEnabled Boolean  @default(false) // création de compte à la commande
  deployEnabled           Boolean  @default(false) // Phase 10bis GitHub → Coolify
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// Phase 10 (ADR-027): client-generated 6-digit support access code. The raw
// code is shown ONCE and never stored: only HMAC-SHA256(pepper, code) is kept
// (`codeHash`). One active code per client (generation revokes the previous in
// a $transaction). 5 wrong attempts auto-lock (revokedAt).
model SupportCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Phase 10 (ADR-027): minimal support tickets. `escalatedTo` reuses the Role
// enum (only SUPPORT_L2 / SUPPORT_L3 are valid escalation targets, enforced in
// the service). `authorEmail` on messages is a denormalized snapshot that
// survives the author being deleted.
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CLIENT
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Ticket {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(NORMAL)
  escalatedTo Role?
  escalatedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages TicketMessage[]

  @@index([userId])
  @@index([status])
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorEmail String // dénormalisé (survit à la suppression de l'auteur)
  body        String
  createdAt   DateTime @default(now())

  @@index([ticketId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique // sha256 of the raw refresh token; raw value never stored
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ── Phase 2 — core domain (ADR-017): platform-global reference entities ──────
// Product (catalog item) and Server (infrastructure host) are GLOBAL platform
// data, administered by the platform in /manager. They carry NO ownerId: they are
// NOT client-owned. Client-owned resources (Subscription/Service/Deployment…) are
// deliberately deferred to future phases when a real workflow needs them.
// Access: Product readable by any authenticated; soldered mutations ADMIN-only.
// Server fully ADMIN-only (internal infrastructure must not be exposed to clients).

enum ProductStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  DISABLED
}

// Pack d'hébergement (Catalog) : gabarit réutilisable de ressources proposé à
// un Produit. Les limites RAM/CPU appliquées à l'app Coolify au déploiement
// (limits_cpus/limits_memory) ; disque + bande passante = informatifs (Coolify
// ne les enforce pas au niveau application). Suppression protégée par le FK
// Restrict de Product.pack (passer status=DISABLED pour dissocier).
enum PackStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ServerStatus {
  UNKNOWN
  PROVISIONING
  ACTIVE
  PROBLEM
  REMOVED
}

// Module de panneau serveur (adaptateur d'infra). Début = les deux fournisseurs
// ciblés ; cPanel / DirectAdmin / autres s'ajouteront quand leurs connecteurs
// seront configurés (ADR-010 providers, ADR-024).
enum ServerPanelProvider {
  NONE
  HESTIA
  COOLIFY
}

model Product {
  id        String        @id @default(cuid())
  name      String        @unique
  kind      String        @default("generic") // not an enum yet: product-kind list is immature; promote when stable
  status    ProductStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  subscriptions Subscription[] // clients subscribing to this offering (Phase 5)

  // ── Catalog (Phase 12) — classification + ressources ──────────────────────
  // Product → ProductCategory (classification, optionnelle, SetNull) et
  // Product → HostingPack (ressources, Restrict — passer DISABLED pour
  // dissocier). Le pack pilote les limites appliquées à l'app Coolify au
  // déploiement (service → subscription → product → pack).
  categoryId String?
  category   ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  packId     String?
  pack       HostingPack?     @relation(fields: [packId], references: [id], onDelete: Restrict)

  // ── Phase 15 — Store / Checkout / Wallet / Facturation (prompt type WHMCS) ─
  // Fiche produit "vitrine" : le catalogue public ne montre QUE status=ACTIVE
  // (règle métier centrale du store) et `hidden` (masqué) PRIME même sur ACTIVE
  // (produit accessible uniquement via lien direct). `slug` = URL publique
  // app.arumdigital.com/store/<slug>. Pricing en cents Int (devise BillingSetting).
  slug               String?          @unique
  slogan             String?
  shortDescription   String? // ≤ 50 mots recommandé (vente croisée)
  // Plan Gratuit : produit à $0 à but d'inscription directe. Marqué ici pour
  // (a) ouvrir l'inscription sans checkout-intent (signup dédié) et (b) rendre
  // la fiche produit auth-aware (« Commencez gratuitement » ↦ « Créer un projet »).
  freePlan           Boolean          @default(false)
  description        String? // HTML basique (br/strong/em) — fiche produit publique
  color              String?          @default("#00b377")
  hidden             Boolean          @default(false) // "Créer en tant que Masqué"
  displayOrder       Int              @default(0)
  priceHtCents       Int? // prix HT en centimes (ex 9900 = $99.00)
  promoPriceHtCents  Int? // prix promo HT affiché barré (optionnel)
  billingCycle       BillingCycle     @default(ONETIME)
  taxRateId          String? // taux de taxe référencé depuis la config globale
  taxRate            TaxRate?         @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  domainRequired     Boolean          @default(false) // active l'étape "choix du domaine" au checkout
  welcomeEmailTemplate String? // nom du template d'email de bienvenue (envoyé après provisioning)
  stockEnabled       Boolean          @default(false)
  stockQty           Int?
  crossSell          Boolean          @default(false) // éligibilité aux ventes croisées
  // Contrôles du récap /cart, par produit (admin).
  allowEditConfig      Boolean @default(true) // affiche « Modifier la configuration » sur /cart
  installationFeeCents Int     @default(0)    // prix d'installation affiché sur le récap (0 = à défaut)
  // Module de provisioning (méthode réutilisable) + paramètres clé/valeur.
  provisionModuleId  String?
  provisionModule    ProvisionMethod? @relation(fields: [provisionModuleId], references: [id], onDelete: SetNull)
  moduleParams       Json? // clé/valeur spécifiques au module pour CE produit (ex. serveur, template)
  // Onglet 8 — règles des sous-domaines gratuits de CE produit (1:1).
  freeSubdomainRule  FreeSubdomainRule?
  // Multi-catégories (cases à cocher — Onglet 4) : la `category` ci-dessus est la
  // catégorie PRINCIPALE ; `categoryLinks` porte les catégories additionnelles.
  categoryLinks      ProductCategoryLink[]
  options            ProductOption[] // options configurables (Onglet 6)
  addons             ProductAddon[] // suppléments/add-ons (Onglet 7)
  checkoutFields     ProductCheckoutField[] // champs de facturation configurables (admin)
  orders             Order[] // commandes passées sur ce produit (Phase 15)
}

// ── Phase 15 — Taux de taxe (config globale, Onglet 2 référence ces taux) ─────
// L'admin définit des taux nommés (ex. "TVA 20% Standard", "Exonéré") ; le défaut
// d'install est Exonéré (0%). Un produit référence un TaxRate ; null = 0%.
model TaxRate {
  id          String   @id @default(cuid())
  name        String   @unique
  ratePercent Decimal  @db.Decimal(5, 2) // ex 20.00, 5.50, 0.00
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[] // produits référençant ce taux
}

// ── Phase 15 — Lien produit ↔ catégorie (multi-catégories, Onglet 4) ──────────
model ProductCategoryLink {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
}

// ── Phase 15 — Option configurable (Onglet 6) ────────────────────────────────
// Option ajustable par le client à l'achat, avec ses choix possibles portant
// chacun un supplément de prix (ex. "RAM additionnelle: +1/+2/+4 Go → +X/mois").
model ProductOption {
  id        String                @id @default(cuid())
  productId String
  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  required  Boolean               @default(false)
  sortOrder Int                   @default(0)
  choices   ProductOptionChoice[]

  @@index([productId])
}

model ProductOptionChoice {
  id              String         @id @default(cuid())
  optionId        String
  option          ProductOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  label           String
  priceDeltaHtCents Int // supplément de prix HT en centimes (+$X par cycle)
  sortOrder       Int            @default(0)

  @@index([optionId])
}

// ── Phase 15 — Supplément / add-on (Onglet 7) ────────────────────────────────
// Extension proposable au moment de la commande (sauvegarde quotidienne, IP
// dédiée…), chacun avec nom, description, prix.
model ProductAddon {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  priceHtCents Int // prix HT en centimes (par cycle du produit)
  sortOrder    Int      @default(0)

  @@index([productId])
}

// ── Phase 15 — Champ de facturation configurable (Onglet admin, par produit) ──
// L'admin définit les champs que le client remplit à l'étape /cart (nom, email,
// tél par défaut ; possibilité d'ajouter société, adresse, note…). `key` = identifiant
// stable (name|email|phone|company|…) réutilisé côté serveur au checkout ; `enabled`
// retire un champ du formulaire, `required` impose la saisie, `sortOrder` ordonne.
model ProductCheckoutField {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key         String // name | email | phone | company | custom_*
  label       String
  type        CheckoutFieldType @default(TEXT) // TEXT | EMAIL | TEL
  placeholder String?
  required    Boolean  @default(false)
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)

  @@index([productId])
}

enum CheckoutFieldType {
  TEXT
  EMAIL
  TEL
}

// ── Phase 15 — Règles des sous-domaines gratuits (Onglet 8, 1:1 par produit) ──
// Les domaines ELIGIBLES = la liste des zones racines Cloudflare (table Domain,
// status ACTIVE) — l'admin en ajoute via le module DNS ; le client choisit celui
// qui lui convient dans une liste déroulante au checkout. `allowedDomainIds`
// vide = tous les domaines ACTIVE (défaut). Préfixes réservés + contraintes de
// format alimentent la validation de l'étape domaine du tunnel d'achat.
model FreeSubdomainRule {
  id               String   @id @default(cuid())
  productId        String   @unique
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  allowedDomainIds String[] @default([]) // vides = tous les Domain ACTIVE
  reservedPrefixes String[] @default([]) // mots/prefixes interdits (ex. "admin", "www")
  minLength        Int      @default(3)
  maxLength        Int      @default(40)
  allowedChars     String   @default("a-z0-9-")
  rejectPattern    String? // regex additionnelle à rejeter (optionnelle)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ── Phase 15 — Méthode de provisioning réutilisable (Onglet 3) ──────────────
// Registre de "méthodes de module de provisioning" (nom, endpoint/webhook,
// actions déclenchées : create_app / dns / ssl / backup…). Un produit choisit une
// méthode + des moduleParams. DISTINCT de DeploymentModule (placement des apps
// GitHub→Coolify existant) : ici il s'agit de la méthode d'approvisionnement
// d'une commande store (app WordPress + sous-domaine + SSL).
enum ProvisionAction {
  CREATE_APP
  CONFIGURE_DNS
  GENERATE_SSL
  ENABLE_BACKUP
}

model ProvisionMethod {
  id          String            @id @default(cuid())
  name        String            @unique
  code        String            @unique // slug machine, ex "icode-wp-orchestrator"
  description String?
  endpoint    String? // endpoint/webhook d'appel de la méthode
  actions     ProvisionAction[] // actions déclenchées par cette méthode
  isActive    Boolean           @default(true)
  isSystem    Boolean           @default(false) // méthode intégrée (non supprimable)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  products Product[]
}

model HostingPack {
  id                 String            @id @default(cuid())
  name               String            @unique
  description        String?
  ramMb              Int // RAM (Mo)
  cpuCores           Float             @default(1) // cœurs (fraction autorisée, ex 0.5)
  storageLimit       Int? // stockage limite (Go) — VALEUR ENREGISTRÉE, quota NON actif
  // encore (architecture Plan.cpu_limit / memory_limit / storage_limit : seule la
  // RAM/CPU sont appliqués à la création ; le système de quota disque arrive après
  // la mise en prod).
  bandwidth          String? // bande passante, label libre ex « 1 To / mois »
  // Quota d'applications du plan (Phase 13) : 1 / 5 / 10… null = illimité. Le
  // nombre d'apps du client sous l'abonnement ACTIF lié à ce pack est plafonné.
  maxApps            Int?
  // Méthode de déploiement du plan (Phase 13) : le module (A projet partagé /
  // B projet client) qui héberge les apps de ce pack. null = déploiement non
  // configuré pour ce pack (le module par défaut actif fait office de fallback).
  deploymentModuleId String?
  deploymentModule   DeploymentModule? @relation(fields: [deploymentModuleId], references: [id], onDelete: SetNull)
  status             PackStatus        @default(ACTIVE)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  products   Product[] // packs référencés par des produits (Restrict)
  categories ProductCategory[] // catégories dont ce pack est le recommandé
}

// ── Phase 13 — modules/méthodes de déploiement (A/B) ─────────────────────────
// Un DeploymentModule définit COMMENT les apps client sont placées sur Coolify :
//  - SHARED_PROJECT (Module A) : toutes les apps vont dans UN projet Coolify
//    partagé, choisi par l'admin (liste live, page Packs) — généralisé pour le
//    serveur du module.
//  - PER_CLIENT_PROJECT (Module B) : chaque client a SON projet Coolify, nommé
//    avec un id client unique (retrouvable par le support), créé à la première
//    app ; toutes les apps du client y vivent.
// Les HostingPack sont liés à un module (pack → module). Overrides optionnels de
// limites de ressource appliqués aux apps déployées par ce module.
enum DeploymentModuleKind {
  SHARED_PROJECT // Module A — projet partagé
  PER_CLIENT_PROJECT // Module B — projet dédié par client
}

model DeploymentModule {
  id                   String               @id @default(cuid())
  name                 String               @unique // ex « Module A — projet partagé »
  code                 String               @unique // ex "A", "B", "C"…
  kind                 DeploymentModuleKind
  description          String?
  isActive             Boolean              @default(true)
  // Serveur Coolify sur lequel le module déploie (doit être COOLIFY + connecté).
  serverId             String?
  server               Server?              @relation(fields: [serverId], references: [id], onDelete: SetNull)
  // Module A : projet Coolify partagé sélectionné par l'admin (liste live).
  sharedProjectUuid    String?
  sharedProjectName    String? // snapshot lisible (affiché au support)
  // Module B : préfixe du nom du projet client (ex « client » → client-<uid>).
  perClientPrefix      String               @default("client")
  // Overrides de limites appliqués aux apps de CE module (optionnel).
  overrideRamMb        Int?
  overrideCpuCores     Float?
  overrideStorageLimit Int?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  packs          HostingPack[] // plans liés à ce module
  clientProjects ClientProject[] // projets client créés par ce module (Module B)
  deployments    Deployment[]
}

// Projet Coolify dédié d'un client (Module B) — UN par (client, serveur, module).
// Créé paresseusement à la première app (POST /projects Coolify, idempotent) ou
// via l'action admin « Créer le projet maintenant » (page Utilisateurs).
model ClientProject {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId    String
  server      Server           @relation(fields: [serverId], references: [id], onDelete: Cascade)
  moduleId    String
  module      DeploymentModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name        String // ex « client-<uid> »
  projectUuid String // uuid du projet Coolify
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  deployments Deployment[] // apps déployées dans ce projet (tracabilité)

  @@unique([userId, serverId, moduleId])
  @@index([userId])
}

model ProductCategory {
  id                String       @id @default(cuid())
  name              String       @unique
  description       String?
  displayOrder      Int          @default(0)
  recommendedPackId String? // pack suggéré lors de la création d'un produit de cette catégorie
  recommendedPack   HostingPack? @relation(fields: [recommendedPackId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  products Product[] // produits de cette catégorie (SetNull)
  productCategoryLinks ProductCategoryLink[] // liens multi-catégories (Phase 15)
}

model Server {
  id       String       @id @default(cuid())
  name     String       @unique
  hostname String
  status   ServerStatus @default(UNKNOWN)

  // Détails d'infrastructure (ADR-024) — affichés/édités sur /manager/serveurs,
  // alimentés plus tard par la vraie connexion aux serveurs (ADR-007/010).
  ipAddress        String? // adresse IP publique/privée
  port             Int? // port de gestion (SSH/API)
  provider         String? // fournisseur (Hetzner, OVH, VPS…)
  region           String? // région / localisation (ex. fra1, paris)
  quotaMaxAccounts Int? // quota max de comptes hébergés
  strictTls        Boolean             @default(true) // vérifier strictement les certificats TLS des requêtes API
  panelProvider    ServerPanelProvider @default(NONE) // adaptateur de panneau serveur

  // Sonde de connectivité réelle (Phase 8, ADR-025) — alimentés par
  // POST /api/servers/:id/check. null = jamais sondé ; le statut reste piloté
  // manuellement par l'admin (le résultat de la sonde propose une bascule).
  lastCheckedAt   DateTime?
  lastProbeOk     Boolean?
  lastProbeDetail String?

  // Crédentials API panneau + état de vérification (Phase 9, ADR-010/ADR-008).
  // alimentés/décryptés uniquement côté API ; `apiTokenEnc` est toujours chiffré
  // au repos (AES-256-GCM via CryptoService, clé maîtresse ENCRYPTION_KEY) et
  // JAMAIS renvoyé par l'API (seul `hasApiToken` l'est, dans la vue masquée).
  apiBaseUrl         String? // URL de base de l'API du panneau (ex. https://panel.exemple.com/api/v1)
  apiTokenEnc        String? // jeton/clé d'accès API chiffré au repos (jamais déchiffré côté client)
  apiUser            String? // utilisateur API (Hestia : « api » ; Coolify : inutilisé)
  coolifyProjectUuid String? // projet Coolify cible pour les déploiements (uuid) ; défaut "0" si absent
  coolifyServerUuid  String? // serveur Coolify cible (uuid) ; défaut "0" si absent
  panelVerifiedAt    DateTime? // dernier POST /api/servers/:id/panel-verify
  panelOk            Boolean? // résultat du dernier test API (true = panneau joignable + authentifié)
  panelDetail        String? // détail lisible du dernier test API

  // Métriques annoncées du serveur (Phase 9bis) — auto-détectées via l'API du
  // panneau quand c'est possible (Hestia `sysinfo`), sinon saisies manuellement
  // par l'admin (détails impossibles à récupérer => champ libre). null = inconnu.
  ramMb          Int? // RAM totale (Mo)
  cpuCores       Int? // nombre de cœurs CPU
  diskGb         Int? // disque total (Go)
  bandwidthLimit String? // limite de bande passante (label libre, ex. "2 To / mois")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deployments       Deployment[] // déploiements GitHub → Coolify sur ce serveur (Phase 10bis)
  deploymentModules DeploymentModule[] // modules/méthodes de déploiement de ce serveur (Phase 13)
  clientProjects    ClientProject[] // projets Coolify client hébergés ici (Module B)
}

// ── Phase 4 — audit journal (ADR-019) ────────────────────────────────────────
// Append-only, readable only by ADMIN, emitted explicitly by services. No
// update/delete endpoints. actorId is a real (nullable) FK to User — null when
// the actor isn't a valid account (e.g. a failed login). actorEmail is a
// denormalized snapshot that survives the user being deleted or renamed.
// resourceType/resourceId are polymorphic strings (the referenced resource
// varies: user/product/server), so there is deliberately NO relation to them.

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail   String?
  action       String
  resourceType String?
  resourceId   String?
  details      Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([resourceType])
  @@index([action])
}

// ── Phase 5 — invitations (ADR-020) ─────────────────────────────────────────
// Public self-registration is CLOSED (ADR-020). New USER accounts are created
// only through an ADMIN-issued invitation. The raw invite token is shown once
// (surfaced in /manager until an email strategy exists); only its sha256 is
// stored, like the refresh token. issuerId is nullable + SetNull so a deleted
// admin's pending invites survive.

model Invitation {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique // sha256 of the raw one-time token
  issuerId  String?
  issuer    User?     @relation(fields: [issuerId], references: [id], onDelete: SetNull)
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

// ── Phase 5 — client workspace (ADR-021) ────────────────────────────────────
// First CLIENT-OWNED resources (the workflow ADR-017 deferred until a real one
// existed): a USER subscribes to a platform Product; once an ADMIN approves the
// Subscription, the client can request a Service under it; the ADMIN assigns a
// hosting Server (the client never touches infrastructure). Provisioning is a
// status-transition STUB — real provider deploy (ADR-010) and async jobs
// (ADR-007) remain OUT of scope and Deployment stays deferred.
// Ownership is enforced in the service layer: a USER can only reach their own
// subscriptions/services (404 for anyone else's).

enum SubscriptionStatus {
  PENDING
  ACTIVE // approved by admin
  REJECTED
  SUSPENDED
  CANCELLED
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  status    SubscriptionStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  // Commande store à l'origine de l'abonnement (création ou upgrade). Tous les
  // abonnements passent par la procédure de commande ; l'upgrade repointe la MÊME
  // ligne. 1:1.
  orderId String? @unique
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

// ── Phase 10bis — déploiement GitHub → Coolify (Deployment) ──────────────────
// Ressource PROPRIÉTÉ du client (même pattern que Subscription/Service, ADR-021) :
// un dépôt GitHub du client est déployé par la plateforme sur le serveur Coolify
// « actuellement connecté » — celui que l'admin a affecté au Service ACTIVE du
// client (panelProvider=COOLIFY + panelOk=true). L'ownership est vérifiée dans le
// service (where userId — un autre client voit 404). `coolifyUuid` est l'UUID de
// l'application côté Coolify : stocké côté serveur UNIQUEMENT, jamais renvoyé au
// client (pas d'exposition d'infrastructure, ADR-021). Le statut est pollé par le
// client (GET /api/client/deployments/:id rafraîchit l'état via l'API Coolify).

enum DeploymentStatus {
  PENDING
  DEPLOYING
  ACTIVE // déploiement terminé avec succès
  FAILED
}

model Deployment {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Phase 13 (Bloc 4) : le client déploie SANS choisir un Service (table retirée) —
  // la cible est résolue depuis le pack ACTIF → module A/B.
  serverId           String?
  server             Server?           @relation(fields: [serverId], references: [id], onDelete: SetNull)
  repoFullName       String // "owner/repo" tel que détecté sur GitHub (mode GH lié) ou dérivé de l'URL (mode URL)
  repoUrl            String? // URL git collée par le client (mode URL 10bis.5) — null en mode GitHub lié
  buildPack          String? // build pack envoyé à Coolify (nixpacks/dockerfile/…) — jamais exposé en infrastructure
  appName            String? // nom de l'application côté Coolify (mode URL : modifiable par le client)
  branch             String            @default("main")
  coolifyUuid        String? // UUID de l'application Coolify (jamais exposé au client)
  status             DeploymentStatus  @default(PENDING)
  detail             String?
  // Phase 3 (Cloudflare) : sous-domaine gratuit alloué au déploiement. `fqdn`
  // (ex monapp.arumdigital.com) est l'URL reachable exposée au client ; elle est
  // portée par la classe ClientSubdomain (l'enregistrement DNS créé sur Cloudflare).
  subdomain          String?
  domainId           String?
  domain             Domain?           @relation(fields: [domainId], references: [id], onDelete: SetNull)
  fqdn               String?           @unique
  clientSubdomain    ClientSubdomain?
  // Phase 16 — build « file-based » (codediali.toml / netlify.toml) → config du
  // build appliquée à Coolify et persistée ici pour re-déploiement déterministe.
  baseDirectory      String? // monorepo : sous-dossier racine du build
  buildCommand       String? // commande de build
  installCommand     String? // commande d'installation de dépendances
  publishDirectory   String? // dossier de publication (sortie de build / statique)
  functionsDirectory String? // dossier de fonctions (best-effort, info)
  environment        Json? // variables d'environnement du BUILD (whitelist)
  // Phase 13 — projet Coolify qui héberge l'app (monitoring + support). Le
  // module (A partagé / B client) et le projet client (Module B) sont tracés.
  coolifyProjectUuid String?
  moduleId           String?
  module             DeploymentModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  clientProjectId    String?
  clientProject      ClientProject?    @relation(fields: [clientProjectId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([userId])
  @@index([status])
}

// ── Phase 3 — DNS & sous-domaines Cloudflare (demande propriétaire) ──────────
// Le contrôle DNS EST Cloudflare ("proxy live") : la table des enregistrements
// lit/écrit directement l'API v4 (Bearer). Les tables locales ne PORTENT que la
// configuration : le compte (CloudflareSetting, SINGLETON comme SecuritySetting),
// les zones racines importées (Domain, la "liste" que l'admin sélectionne) et
// les sous-domaines alloués aux apps client (ClientSubdomain).
// Le jeton est AES-256-GCM au repos (CryptoService) et JAMAIS renvoyé par l'API
// (seule une vue `hasApiToken`).

enum DomainStatus {
  ACTIVE
  DISABLED // retiré de l'UI mais conservé (aucune nouvelle allocation)
}

enum SubdomainStatus {
  PENDING // en attente de création côté Cloudflare
  CREATED // enregistrement CNAME créé (recordId)
  ERROR // échec de création DNS
}

// SINGLETON (un champ racine, ≤ 1 domaine racine) — même patron que SecuritySetting.
model CloudflareSetting {
  id           String   @id @default(cuid())
  apiTokenEnc  String? // jeton Cloudflare API, AES-256-GCM — jamais exposé
  accountEmail String?
  rootDomainId String?  @unique // ≤ 1 racine sélectionnée (singleton)
  rootDomain   Domain?  @relation("RootDomain", fields: [rootDomainId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Zones racines importées depuis le compte Cloudflare ("la liste" admin).
model Domain {
  id               String             @id @default(cuid())
  name             String             @unique // ex arumdigital.com
  zoneId           String             @unique // zone Cloudflare (id de zone)
  // Hostname cible des CNAME clients (ex panel.arumdigital.com). Si non renseigné,
  // fallback : hostname du serveur associé à la Service déployée.
  cnameTarget      String?
  status           DomainStatus       @default(ACTIVE)
  rootOf           CloudflareSetting? @relation("RootDomain") // 1:1 — la racine sélectionnée
  clientSubdomains ClientSubdomain[]
  deployments      Deployment[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
}

// Allocation d'un sous-domaine libre à l'app d'un client (au déploiement).
model ClientSubdomain {
  id           String          @id @default(cuid())
  subdomain    String // ex "monapp" (partie sous le domaine racine)
  domainId     String
  domain       Domain          @relation(fields: [domainId], references: [id], onDelete: Cascade)
  fqdn         String          @unique // ex monapp.arumdigital.com
  recordId     String? // id de l'enregistrement DNS Cloudflare créé
  status       SubdomainStatus @default(PENDING)
  deploymentId String?         @unique // ≤ 1 sous-domaine par déploiement
  deployment   Deployment?     @relation(fields: [deploymentId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())

  @@index([domainId])
  @@index([status])
}

// ── Phase 6 — mail/SMTP configuration (ADR-022) ─────────────────────────────
// SINGLETON row (one row, managed firstOrCreate by MailSettingsService): the
// admin-managed SMTP configuration used to EMAIL invitation links (the Phase 5
// manual token surfacing in /manager stays as a fallback). `enabled` gates
// AUTOMATIC sending on invite creation; the manual "send test email" endpoint
// works against the saved config regardless. `passwordEnc` holds the SMTP
// password AES-256-GCM-encrypted at rest (CryptoService, master key
// ENCRYPTION_KEY) — it is NEVER returned by the API (only `hasPassword`).

model MailSetting {
  id          String   @id @default(cuid())
  enabled     Boolean  @default(false)
  host        String
  port        Int      @default(587)
  secure      Boolean  @default(false) // true = implicit TLS (465), false = STARTTLS (587)
  user        String?
  passwordEnc String?
  fromEmail   String
  fromName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Phase 11 — base de connaissance (KnowledgeArticle) ──────────────────────
// UNE table pour les DEUX bases demandées par le propriétaire :
//  - `audience = ADMIN` : base "Admin only" — articles INFORMATIF (récap des
//    phases effectuées, champ `phase` lié), TECHNIQUE (détails d'implémentation)
//    et HOWTO (comment utiliser les options du système) — jamais servis au client.
//  - `audience = CLIENT` : base accessible au client (/aide) — articles de
//    support / explication des options, le tout géré et publié par l'admin
//    (statut DRAFT → PUBLISHED → ARCHIVED ; seul PUBLISHED est servi).
// `body` est du HTML (sanitisé à l'affichage), `summary` un extrait en clair.
// `slug` est unique par audience. L'API n'expose jamais un article non-PUBLISHED
// côté client ; côté admin, tout est visible.

enum KnowledgeAudience {
  ADMIN // base interne admin : informative / technique / howto
  CLIENT // base publique /aide : support + explication des options
}

enum KnowledgeType {
  INFORMATIVE // récap des phases effectuées (ADMIN)
  TECHNICAL // détails techniques du projet (ADMIN)
  HOWTO // guide "comment faire" (ADMIN) — et support (CLIENT)
}

enum KnowledgeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model KnowledgeArticle {
  id          String            @id @default(cuid())
  audience    KnowledgeAudience
  type        KnowledgeType
  status      KnowledgeStatus   @default(DRAFT)
  title       String
  slug        String
  summary     String?
  body        String // HTML
  category    String? // catégorie client (ex. "Prise en main", "Facturation") — ADMIN: phase ou domaine
  phase       String? // ex. "Phase 10" — lié à un article INFORMATIF
  tags        String[]          @default([]) // étiquettes libres (recherche)
  authorId    String?
  author      User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorEmail String // dénormalisé (survit à la suppression de l'auteur)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  publishedAt DateTime?

  @@unique([audience, slug])
  @@index([audience, status])
  @@index([audience, category])
}

// Phase 14 (ADR-0xx): branding white-label, SINGLETON (une ligne, id fixe
// 'brand'). La plateforme est vendue à plusieurs marques (un brand/install) :
// partie publique `GET /api/brand` alimente le front (nom/logo/couleurs), et
// l'admin configure via /manager/apparence. Valeurs par défaut = marque actuelle
// (celle gravée dans web/src/config/brand.ts + tokens --brand-*). primaryColor
// pilote toute l'UI (les autres teintes en dérivent), reset restaure les défauts.
enum BrandLogoType {
  DEFAULT // initiales du nom (tile), logo actuel par défaut
  TEXT // wordmark : nom stylisé (logoText)
  IMAGE // image importée (fichier servi via /branding/*)
}

model BrandConfig {
  id           String        @id // singleton — id fixe 'brand'
  name         String        @default("Code Diali")
  sub          String        @default("Self-hosted hosting control plane")
  tagline      String? // tag de pilule (ex. "CLOUD", null = aucun)
  hostname     String? // domaine de la marque (stocké/affiché, non routant pour l'instant)
  logoType     BrandLogoType @default(DEFAULT)
  logoText     String? // wordmark si logoType = TEXT
  logoUrl      String? // chemin relatif /branding/<file> si logoType = IMAGE
  logoShowText Boolean       @default(false) // IMAGE : afficher aussi le wordmark
  primaryColor String        @default("#00b377")
  accentColor  String? // null = dérivé de primary
  updatedById  String? // acteur admin (audit/affichage, sans relation forte)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// ── Phase 15 — STORE / CHECKOUT / WALLET / FACTURATION (type WHMCS) ──────────
// Tunnel de vente GRAND PUBLIC (pas de compte obligatoire) + solde prépayé
// (wallet) + back-office commandes & facturation. Devise par défaut USD,
// taxe par défaut Exonéré (0%) (décisions propriétaire, 2026-09-08). Argent
// toujours en CENTS (Int) pour éviter les erreurs de flottant ; taux de taxe en
// Decimal. Aucun fournisseur de paiement CARTE pour l'instant (virement +
// transfert manuel d'abord) — PaymentMethodType.CARD réservé pour l'étape 5.

enum BillingCycle {
  MONTHLY
  YEARLY
  ONETIME
}

enum CustomerAccountType {
  LIGHT // aucun mot de passe — identifié par email (lien magique / mot de passe temporaire)
  FULL // compte « complet » (utilisateur existant ou créé)
}

enum PaymentMethodType {
  BANK_TRANSFER // virement — coordonnées affichées + référence unique, valide admin/webhook
  MANUAL_TRANSFER // transfert manuel (Western Union / mobile money…) avec preuve uploadée
  CARD // carte bancaire (réservé — intégration prestataire à venir, étape 5)
}

enum FeeType {
  NONE
  PERCENT
  FIXED
  PERCENT_AND_FIXED
}

enum WalletTransactionType {
  CREDIT // recharge du wallet (recharge validée)
  DEBIT // débit lié à une commande / facture
  REFUND // remboursement (recrédite le wallet)
  ADJUSTMENT // ajustement manuel admin
}

enum WalletTxStatus {
  PENDING // recharge virement/transfert en attente de validation admin
  SUCCEEDED
  FAILED
  CANCELED
}

enum OrderStatus {
  PENDING_PAYMENT // En attente de paiement
  PAID // Payée
  PROVISIONING // En cours de provisioning
  ACTIVE // Active
  SUSPENDED // Suspendue
  CANCELLED // Annulée
  REFUNDED // Remboursée
}

enum OrderDomainType {
  NONE // produit sans domaine requis
  EXISTING_DOMAIN // « Mon domaine existant » — attente de propagation DNS
  FREE_SUBDOMAIN // sous-domaine gratuit — créé + lié à l'app au provisioning
}

enum OrderDomainStatus {
  NONE
  AWAITING_NS_PROPAGATION // pointe vers des nameservers à vérifier périodiquement
  READY // sous-domaine créé (DNS + SSL) ou propagation confirmée
}

enum InvoiceStatus {
  UNPAID
  PAID
  CANCELLED
  REFUNDED
  CREDITED // réglé par avoir (credit note)
}

enum InvoiceLineKind {
  PRODUCT
  OPTION
  ADDON
  ADJUSTMENT
  CREDIT
}

enum ProvisioningStepStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

// ── Client (compte "léger" ou "complet") ───────────────────────────────────
// Identifié par email. Un client peut exister SANS compte utilisateur
// « traditionnel » (type LIGHT) : l'accès se fait par lien sécurisé envoyé par
// email (lien magique / mot de passe temporaire, étape 5). `userId` relie à un
// compte existant quand il y en a un. `walletBalanceCents` est dérivé des
// WalletTransaction et mis à jour en $transaction (jamais une simple lecture).
model Customer {
  id                String              @id @default(cuid())
  email             String              @unique
  name              String
  phone             String?
  accountType       CustomerAccountType @default(LIGHT)
  userId            String?             @unique // comptes « complets » liés à un User
  walletBalanceCents Int                @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  walletTransactions WalletTransaction[]
  orders             Order[]
  invoices           Invoice[]

  @@index([email])
}

// ── Moyen de paiement (config admin, section 3.2) ──────────────────────────
// Un moyen par ligne : actif/inactif, type, configuration d'affichage (config
// Json : coordonnées bancaires, instructions de transfert…), frais éventuels.
// Les SECRETS (clés API carte) seront stockés chiffrés (`configEnc`,
// CryptoService AES-256-GCM) à l'étape 5 — JAMAIS renvoyés (seul `hasConfig`).
model PaymentMethod {
  id            String            @id @default(cuid())
  name          String            @unique
  type          PaymentMethodType
  isActive      Boolean           @default(false) // activé/désactivé par l'admin (global)
  displayOrder  Int               @default(0)
  config        Json? // paramètres NON secrets (coordonnées bancaires, instructions)
  configEnc     String? // secrets chiffrés (carte) — jamais exposés par l'API
  feeType       FeeType           @default(NONE)
  feePercent    Decimal?          @db.Decimal(5, 2) // % si PERCENT
  feeFixedCents Int? // frais fixe en centimes si FIXED
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  walletTransactions WalletTransaction[] // recharges via ce moyen
  orders             Order[] // commandes réglées via ce moyen (snapshot)
}

// ── Transaction wallet (solde client) ─────────────────────────────────────
// Journal append-only des CREDIT/DEBIT/REFUND/ADJUSTMENT. `idempotencyKey`
// UNIQUE garantit l'idempotence de toute opération financière (pas de double
// débit en cas de double clic/retry, section 7). `reference` = référence
// humaine unique pour les virements. `proofPath` = preuve de paiement uploadée
// (virement/transfert), lisible admin + client concerné uniquement.
model WalletTransaction {
  id              String              @id @default(cuid())
  customerId      String
  customer        Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type            WalletTransactionType
  amountCents     Int // positif
  currency        String              @default("USD")
  status          WalletTxStatus      @default(PENDING)
  paymentMethodId String?
  paymentMethod   PaymentMethod?      @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  methodName      String? // snapshot du moyen de paiement
  reference       String?             @unique // ref. de virement / transfert
  idempotencyKey  String              @unique
  orderId         String?
  invoiceId       String?
  proofFileName   String? // nom du fichier de preuve uploadé (virement/transfert)
  proofPath       String? // chemin de la preuve stockée (admin + client seulement)
  proofMime       String?
  adminActorId    String? // qui a validé/rejeté une recharge (audit)
  adminActorEmail String? // snapshot (survit à la suppression de l'acteur)
  note            String?
  createdAt       DateTime            @default(now())
  processedAt     DateTime?

  @@index([customerId])
  @@index([status])
}

// ── Commande (Order) ───────────────────────────────────────────────────────
// Une commande du tunnel de vente public. Montants en cents avec des snapshots
// dénormalisés (client, produit, paiement) pour une traçabilité qui survit aux
// changements. `domainType/domainValue` portent le choix de domaine (étape 2.2).
// `renewsOrderId` chaîne les renouvellements d'abonnement (cycle récurrent).
model Order {
  id                String            @id @default(cuid())
  // Hash déterministe (email + config + montant + moyen) — garantit qu'un
  // double-clic / retry identique ne crée qu'UNE commande (§7 idempotence).
  idempotencyKey    String?           @unique
  customerId        String
  customer          Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerName      String // snapshot
  customerEmail     String // snapshot
  customerPhone     String?
  productId         String
  product           Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName       String // snapshot
  packId            String? // pack provisionné (ressources/apps)
  status            OrderStatus       @default(PENDING_PAYMENT)
  billingCycle      BillingCycle      @default(ONETIME)
  currency          String            @default("USD")
  taxRatePercent    Decimal           @default(0) @db.Decimal(7, 4) // taux appliqué (snapshot)
  amountHtCents     Int // total HT (produit + options + suppléments)
  taxAmountCents    Int
  amountTtcCents    Int // total TTC
  domainType        OrderDomainType   @default(NONE)
  domainValue       String? // domaine saisi / fqdn choisi
  domainStatus      OrderDomainStatus @default(NONE)
  // Sous-domaine CHOSI par le client au checkout (Plan Gratuit / produits avec
  // sous-domaine) : passé en `requested` à l'allocation Cloudflare par le
  // provisioning (actionConfigureDns). Null = sous-domaine auto-généré.
  requestedSubdomain String?
  paymentMethodId   String?
  paymentMethod     PaymentMethod?    @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  paymentMethodName String? // snapshot
  walletTransactionId String?         @unique // trace du règlement par wallet
  optionsSnapshot   Json? // options configurables choisies (label + supplément)
  addonsSnapshot    Json? // suppléments retenus (label + prix)
  nextBillingDate   DateTime? // prochaine échéance (cycle récurrent)
  autoRenew         Boolean           @default(false)
  renewsOrderId     String?           @unique // commande mère renouvelée
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  statusHistory OrderStatusHistory[]
  invoice       Invoice?
  provisioningLogs ProvisioningLog[]
  // Back-relation : l'abonnement créé/upgradé par cette commande (modèle
  // order-driven). Le FK vit sur Subscription.orderId (1:1, où l'abonnement
  // référence toujours sa dernière commande).
  subscription Subscription?

  @@index([customerId])
  @@index([status])
  @@index([productId])
}

// ── Historique des statuts d'une commande ──────────────────────────────────
model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  note        String?
  actorId     String?
  actorEmail  String?
  createdAt   DateTime    @default(now())

  @@index([orderId])
}

// ── Facture (Invoice) ──────────────────────────────────────────────────────
// Une facture par commande payée (+ factures récurrentes / ad hoc admin).
// `number` numérotation séquentielle (« YYYY-<seq> », compteur BillingSetting).
// Lignes DÉTAILLÉES (InvoiceLine) : produit + options + suppléments, chacun avec
// son prix HT/taxe. `walletTransactionId` trace le règlement par wallet.
// `creditNoteOfId` : avoir (partiel/total) qui recrédite le wallet client.
model Invoice {
  id                        String        @id @default(cuid())
  number                    String        @unique // ex "2026-0003"
  orderId                   String?       @unique // ≥ 1 facture par commande
  order                     Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customerId                String
  customer                  Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status                    InvoiceStatus @default(UNPAID)
  currency                  String        @default("USD")
  taxRatePercent            Decimal       @default(0) @db.Decimal(7, 4)
  amountHtCents             Int
  taxAmountCents            Int
  amountTtcCents            Int
  issuedAt                  DateTime      @default(now())
  dueDate                   DateTime?
  paidAt                    DateTime?
  walletTransactionId       String?       @unique // trace du règlement
  pdfPath                   String? // PDF généré (stocké, téléchargeable)
  creditNoteOfId            String?       @unique // avoir émis sur cette facture
  creditNoteOf              Invoice?      @relation("CreditNote", fields: [creditNoteOfId], references: [id], onDelete: SetNull)
  legalMentionsSnapshot     Json? // mentions légales au moment de l'émission
  billingAddress            Json? // adresse facturation (snapshot)

  lines        InvoiceLine[]
  creditNotes  Invoice[] @relation("CreditNote")

  @@index([customerId])
  @@index([status])
}

model InvoiceLine {
  id              String          @id @default(cuid())
  invoiceId       String
  invoice         Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind            InvoiceLineKind
  label           String
  qty             Int             @default(1)
  unitPriceHtCents Int
  taxRatePercent  Decimal         @default(0) @db.Decimal(7, 4)
  taxAmountCents  Int
  totalTtcCents   Int
  sortOrder       Int             @default(0)

  @@index([invoiceId])
}

// ── Logs de provisioning d'une commande ────────────────────────────────────
model ProvisioningLog {
  id        String                 @id @default(cuid())
  orderId   String
  order     Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  step      String // ex "create_app", "create_subdomain", "ssl", "send_email"
  status    ProvisioningStepStatus @default(PENDING)
  message   String?
  createdAt DateTime               @default(now())

  @@index([orderId])
}

// ── Paramètres globaux de facturation (SINGLETON, pattern MailSetting) ─────
// Devise, mentions légales de la société, séquence de numérotation des
// factures, délais du dunning progressif (rappel J-3, J-0, suspension J+X).
// Une ligne créée paresseusement (firstOrCreate) aux défauts ci-dessous.
model BillingSetting {
  id                  String   @id @default(cuid())
  currency            String   @default("USD")
  companyName         String   @default("")
  companyAddress      String?
  companyTaxId        String? // n° TVA/SIREN… (affiché sur la facture si renseigné)
  companyEmail        String?
  legalMentions       Json? // mentions complémentaires (lignes de pied de facture)
  invoiceSequence     Int      @default(1) // prochain n° — format « YYYY-<seq> »
  dunningReminderDays Int      @default(3) // rappel avant échéance (J-3)
  dunningGraceDays    Int      @default(14) // délai avant suspension (J+14)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
