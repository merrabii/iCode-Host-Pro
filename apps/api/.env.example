# iCode Host Pro API — development config socle (Phase 0/1, ADR-011).
# ADR-008 (secrets, encryption, persisted config) remains PROPOSED — not covered here.

NODE_ENV=development

# TCP port the NestJS HTTP server listens on
PORT=3001

# PostgreSQL connection string (matches docker-compose.yml, ADR-012)
DATABASE_URL=postgresql://icode:icode@localhost:5432/icode_host_pro?schema=public

# Global REST prefix, also used for Swagger docs (see ADR-005)
API_PREFIX=api

# JWT access token signing secret. DEV-ONLY value below; MUST be a strong random
# secret in any real deployment (Phase 1 / ADR-015). Do not commit a real secret.
JWT_SECRET=dev-only-change-me-use-a-random-secret-in-production-2f8b0c2f

# Access token lifetime (jsonwebtoken duration syntax)
JWT_EXPIRES_IN=15m

# Refresh token lifetime in days (persisted, rotated, revocable)
REFRESH_EXPIRES_IN_DAYS=30

# httpOnly cookie name carrying the refresh token
COOKIE_NAME=ihp_refresh

# Phase 5 — ADMIN-issued invitation lifetime in days (ADR-020). Optional.
INVITE_EXPIRES_IN_DAYS=7

# Phase 6 — master key for encryption at rest (ADR-022): SMTP password stored
# AES-256-GCM-encrypted. OPTIONAL and used only when an admin saves an SMTP
# password; any length accepted (sha256-derived). Random example below — use a
# strong random value and keep it stable across restarts (don't rotate blindly).
ENCRYPTION_KEY=dev-only-change-me-to-a-random-secret-4f9a7c21

# Phase 6 — public base URL used to build absolute invitation links in emails
# (ADR-022). Production: the public host of the web app.
PUBLIC_BASE_URL=http://localhost:3000

# Allowed web origin for CORS (absolute/non-proxy usage)
WEB_ORIGIN=http://localhost:3000

# Phase 2 — platform ADMIN bootstrap (ADR-017). Placeholders ONLY — put real values
# in apps/api/.env (gitignored); never commit a real admin credential.
# Seed: corepack pnpm --filter @icode-host-pro/api run db:seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password