# Code Diali — EXEMPLE de configuration (aucune valeur secrète réelle).
# Copier vers .env à la racine de deploy/ (hors Git, mode 0600) OU injecter les
# valeurs via l'orchestrateur (Coolify : "Environment variables" du projet).
# Ne JAMAIS committer un .env rempli.
#
# SÉPARATION EXPLICITÉE :
# - docker-compose.yml seul = PRODUCTION (aucun port publié).
# - docker-compose.ops.yml = jobs ops (migrate/backup/restore) avec gardes
#   ${VAR:?} strictes — chargé UNIQUEMENT par scripts/ops.sh, jamais par
#   Coolify. Toutes les variables « Jobs ops » et « Restauration » ci-dessous
#   sont alors obligatoires (toute la suite ops est refusée si incomplète).
# - docker-compose.lan.yml = override de VALIDATION LAN uniquement
#   (ports 3111/3112/5433, SANS isolation réseau — egress ouvert) —
#   jamais chargé en prod.
# - docker-compose.lan-internal.yml = mode ISOLATION EGRESS (aucun port,
#   egress bloqué) — pour les campagnes de test provider.
#
# scripts/preflight.sh lit ce fichier (règles identiques à docker compose :
# l'env du processus gagne ; une variable définie mais vide reste un échec).
#
# ---------- Projet compose cible (exigé par scripts/ops.sh) ----------
# COMPOSE_PROJECT_NAME : stack cible — JAMAIS devinée. En preprod = UUID du
# projet Coolify ; stack locale sans Coolify = nom du projet (code-diali).
# Sans cette variable, ops.sh refuse avant tout conteneur.
COMPOSE_PROJECT_NAME=code-diali
# OPS_EXTRA_COMPOSE_FILES (optionnel) : fichiers compose supplémentaires
# séparés par des espaces (ex. : pins d'image/réseau/volumes d'un arbre
# préprod type ops-override.yml). Relatifs à ce dossier ou absolus.
# OPS_EXTRA_COMPOSE_FILES=ops-override.yml

# ---------- PostgreSQL ----------
PG_USER=codediali
PG_PASSWORD=change-me-strong-db-password
PG_DB=code_diali

# ---------- Secrets applicatifs (jamais dans l'image, jamais au build) ----------
# JWT_SECRET : au moins 32 caractères aléatoires (ex : openssl rand -base64 48).
JWT_SECRET=change-me-random-32-chars-minimum
# ENCRYPTION_KEY : CLÉ MAÎTRE de TOUS les secrets chiffrés en base (SMTP, token
# DNS Cloudflare, clés Stripe, serveurs, OAuth, MFA). La PERDRE = secrets
# en base devenus illisibles. La conserver hors VPS (coffre). Format libre :
# le code en dérive une clé AES-256-GCM via sha256 (crypto.service.ts).
ENCRYPTION_KEY=change-me-master-key-offline-vault

# ---------- URL publiques ----------
# PUBLIC_BASE_URL : URL Web vue par le navigateur (liens absolus, redirections) — runtime.
PUBLIC_BASE_URL=http://172.20.116.6:3112
# WEB_ORIGIN : origine navigateur autorisée (cookies/CORS paiements hébergés) — runtime.
WEB_ORIGIN=http://172.20.116.6:3112
# PUBLIC_API_BASE : URL API vue par le NAVIGATEUR (pages de paiement hébergées,
# lue par payment-provider.service) — runtime. Défaut sensible : NEXT_PUBLIC_API_URL.
PUBLIC_API_BASE=http://172.20.116.6:3111
# NEXT_PUBLIC_API_URL : URL API vue par le navigateur — INLINÉE AU BUILD dans le
# bundle Next (NEXT_PUBLIC_*). TOUT changement exige un REBUILD du service web ;
# ce n'est PAS modifiable au runtime (le commentaire compose runtime ne change
# rien côté navigateur). En validation LAN : http://<ip-vm>:3111.
NEXT_PUBLIC_API_URL=http://172.20.116.6:3111
# TRUST_PROXY : derrière le reverse proxy Coolify (réseaux docker RFC1918) :
# "uniquelocal" (défaut compose). La valeur "true" est REFUSÉE par le code
# (X-Forwarded-For forgeable — configuration.ts). Liste d'IP/réseaux acceptée.
TRUST_PROXY=uniquelocal

# ---------- Jobs ops ----------
# DATABASE_URL_OPS : URL EXPLICITE de la base à migrer/sauvegarder (aucun repli).
# Doit pointer sur le serveur/port/base attendus — cf. EXPECTED_* ci-dessous.
DATABASE_URL_OPS=postgresql://codediali:change-me-strong-db-password@db:5432/code_diali?schema=public
# Identité SQL attendue : le nom de base seul NE SUFFIT PAS (deux serveurs peuvent
# porter la même base). Vérification via current_database() + inet_server_addr().
EXPECTED_DB_HOST=db
EXPECTED_DB_PORT=5432
EXPECTED_DB_NAME=code_diali
# Dossier HÔTE monté en /backups dans les jobs migrate/backup : les dumps
# persistent sur l'hôte après suppression du conteneur éphémère du job.
# Le dossier doit EXISTER sur l'hôte AVANT toute commande ops
# (mkdir -p "$dir" && chmod 700 "$dir") : preflight.sh --ops refuse un
# chemin absent, « / » ou « /nonexistent » — docker ne crée jamais de
# dossier parasite à la place.
# ATTENTION honnêteté : un dossier sur l'hôte d'une VM locale = hors conteneur
# MAIS PAS hors VPS. La copie vers un stockage externe (autre machine, objet)
# est une étape SÉPARÉE, NON TESTÉE dans ce lot.
BACKUP_HOST_DIR=/var/backups/code-diali

# ---------- Restauration isolée (job restore) ----------
# Base cible NEUVE dédiée (jamais la base de l'app courante) :
DATABASE_URL_RESTORE=postgresql://codediali:change-me-strong-db-password@db:5432/code_diali_restore?schema=public
EXPECTED_DB_NAME_RESTORE=code_diali_restore
# Dossier HÔTE dédié de restauration (monté /restore) : dump + manifeste à
# placer dedans, fichiers restaurés dans /restore-out (sous-dossier à créer
# VIDE par l'opérateur). Jamais monté sur les volumes de l'app courante.
# Comme BACKUP_HOST_DIR : doit EXISTER sur l'hôte avant toute commande
# (preflight.sh --ops refuse sinon).
RESTORE_HOST_DIR=/var/backups/code-diali-restore
# RESTORE_MANIFEST : valeur par DÉFAUT du manifeste SHA-256 (chemin CONTENEUR,
# /restore/...), surchargée en ligne pour chaque restauration. preflight.sh
# --ops l'exige NON VIDE (la suite ops complète doit être configurée dès
# l'installation — le premier `backup` produit le manifeste réel à renseigner).
RESTORE_MANIFEST=/restore/SHA256SUMS-XXX.txt

# ---------- Admin initial (seed ADR-017 — explicite, jamais au démarrage) ----------
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=fourni-localement-au-moment-du-seed
